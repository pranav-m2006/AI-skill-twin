// PlaceMate AI — Prisma Schema v4
// SQLite for local dev, swappable to PostgreSQL via datasource url

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

// SQLite doesn't support native enums; we use String fields with comments

// Role: STUDENT | FRESHER | EXPERIENCED
// DayStatus: PENDING | IN_PROGRESS | COMPLETED | MISSED
// ApplicationStatus: APPLIED | SHORTLISTED | REJECTED | OFFERED
// BadgeCategory: STREAK | XP | ROADMAP | APTITUDE

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  passwordHash  String
  phone         String?
  role          String   // STUDENT | FRESHER | EXPERIENCED
  qualification String   // BE | BTech | BSc | BCA | ME | MTech | MCA | MSc | Other
  department    String   // CSE | IT | AI&DS | AIML | ECE | EEE | Mechanical | Civil | Other
  college       String?
  location      String?
  domain        String?  // Primary study domain (e.g. DSA, Python, Full Stack)
  targetRole    String?  // e.g. "Software Engineer", "Data Scientist"
  dailyHours    Int?     @default(2) // Hours committed per day for study/roadmap
  yearsExp      Int?     // Experienced only
  prevCompany   String?  // Experienced only
  switchReason  String?  // Experienced only
  resumeUrl     String?  // Path/URL to uploaded resume
  resumeText    String?  // Extracted plain text from resume for matching
  githubUrl     String?  // Optional GitHub profile link
  linkedinUrl   String?  // Optional LinkedIn profile link
  xp            Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  userSkills       UserSkill[]
  skillGaps        SkillGap[]
  roadmaps         Roadmap[]
  dailyActivities  DailyActivity[]
  streakLog        StreakLog?
  userBadges       UserBadge[]
  xpEvents         XpEvent[]
  applications     Application[]
  assessments      Assessment[]
  aptitudeAttempts AptitudeAttempt[]
  progressRecords  ProgressRecord[]
  chatMessages     ChatMessage[]
  notifications    Notification[]
}

// ─────────────────────────────────────────────
// SKILLS
// ─────────────────────────────────────────────

model Skill {
  id       Int    @id @default(autoincrement())
  name     String @unique
  category String // e.g. "Programming", "Database", "Soft Skills"

  userSkills UserSkill[]
  skillGaps  SkillGap[]
  jobSkills  JobSkill[]
}

model UserSkill {
  id          Int    @id @default(autoincrement())
  userId      Int
  skillId     Int
  proficiency Int    @default(0) // 0–100
  evidence    String @default("[]") // JSON array of evidence strings

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
}

model SkillGap {
  id        Int    @id @default(autoincrement())
  userId    Int
  skillId   Int
  gap       Int    // 0–100, higher = bigger gap
  rankOrder Int    // 1 = most critical gap
  reason    String // explanation string

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
}

// ─────────────────────────────────────────────
// ASSESSMENT
// ─────────────────────────────────────────────

model Assessment {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // SKILL | APTITUDE | MOCK_INTERVIEW
  domain    String?
  score     Float    // 0–100
  takenAt   DateTime @default(now())
  metadata  String   @default("{}") // JSON: questions attempted, time taken, etc.

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// APTITUDE
// ─────────────────────────────────────────────

model AptitudeQuestion {
  id          Int    @id @default(autoincrement())
  topic       String // Number System | Percentages | etc.
  difficulty  String // EASY | MEDIUM | HARD
  content     String // Question text
  options     String // JSON array of 4 options
  answer      Int    // Index 0–3 of correct option
  explanation String // Why this answer is correct

  attempts AptitudeAttempt[]
}

model AptitudeAttempt {
  id          Int      @id @default(autoincrement())
  userId      Int
  questionId  Int
  userAnswer  Int      // Index 0–3
  isCorrect   Boolean
  timeTaken   Int      // seconds
  attemptedAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question AptitudeQuestion @relation(fields: [questionId], references: [id])
}

// ─────────────────────────────────────────────
// ROADMAP — Phase → Week → Day → Task
// ─────────────────────────────────────────────

model Roadmap {
  id               Int      @id @default(autoincrement())
  userId           Int
  domain           String   // e.g. "DSA", "Python", "Full Stack"
  level            String   // BEGINNER | INTERMEDIATE | ADVANCED
  dailyHours       Float    // 0.5 | 1 | 1.5 | 2 | 3 | 4 | 5+
  totalDays        Int
  completedDays    Int      @default(0)
  estimatedEndDate DateTime
  actualEndDate    DateTime?
  status           String   @default("ACTIVE") // ACTIVE | COMPLETED | PAUSED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases RoadmapPhase[]
}

model RoadmapPhase {
  id          Int    @id @default(autoincrement())
  roadmapId   Int
  phaseNumber Int    // 1, 2, 3 …
  title       String // e.g. "Phase 1: Foundations"
  description String

  roadmap Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  weeks   RoadmapWeek[]
}

model RoadmapWeek {
  id           Int    @id @default(autoincrement())
  phaseId      Int
  weekNumber   Int    // Global week number within roadmap
  title        String // e.g. "Week 1 — Arrays & Strings"
  isAssessment Boolean @default(false) // true for Day 7 of every week

  phase RoadmapPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  days  RoadmapDay[]
}

model RoadmapDay {
  id               Int      @id @default(autoincrement())
  weekId           Int
  dayNumber        Int      // Global day number within roadmap (1-based)
  title            String   // e.g. "Day 1 — Array basics, traversal"
  topic            String
  learnMinutes     Int
  practiceMinutes  Int
  aptitudeMinutes  Int
  revisionMinutes  Int
  resources        String   @default("[]") // JSON array: { title, url, type }
  xpReward         Int      @default(50)
  status           String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | MISSED
  completionPct    Float    @default(0) // 0–100
  scheduledDate    DateTime?
  completedAt      DateTime?

  week  RoadmapWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  tasks DayTask[]
}

model DayTask {
  id          Int     @id @default(autoincrement())
  dayId       Int
  title       String
  type        String  // LEARN | PRACTICE | APTITUDE | REVISION
  description String
  isCompleted Boolean @default(false)
  completedAt DateTime?

  day RoadmapDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// STREAK & ACTIVITY
// ─────────────────────────────────────────────

model DailyActivity {
  id             Int      @id @default(autoincrement())
  userId         Int
  date           String   // ISO date string "YYYY-MM-DD"
  studyMinutes   Int      @default(0)
  tasksCompleted Int      @default(0)
  tasksTotal     Int      @default(0)
  aptitudeScore  Float?   // score if attempted
  xpEarned       Int      @default(0)
  completionPct  Float    @default(0) // 0–100
  isStreakDay    Boolean  @default(false) // true if completionPct >= COMPLETION_THRESHOLD
  roadmapTopic   String?  // topic studied that day
  badgesEarned   String   @default("[]") // JSON array of badge codes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model StreakLog {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  currentStreak     Int      @default(0)
  longestStreak     Int      @default(0)
  lastCompletedDate String?  // ISO date "YYYY-MM-DD"
  totalCompletedDays Int     @default(0)
  totalMissedDays   Int      @default(0)
  totalActiveDays   Int      @default(0)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// BADGES & XP
// ─────────────────────────────────────────────

model Badge {
  id          Int    @id @default(autoincrement())
  code        String @unique // e.g. "STREAK_3", "CENTURY_LEARNER"
  name        String // e.g. "Consistency Starter"
  description String
  category    String // STREAK | XP | ROADMAP | APTITUDE
  xpReward    Int    @default(0)
  iconName    String @default("Award") // lucide-react icon name

  userBadges UserBadge[]
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  badgeId  Int
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId]) // append-only, never mutated
}

model XpEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  reason    String   // e.g. "Completed Day 5", "Badge: Weekly Warrior"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// JOBS, COMPANIES, INTERNSHIPS
// ─────────────────────────────────────────────

model Company {
  id       Int    @id @default(autoincrement())
  name     String @unique
  industry String
  location String
  website  String?
  overview String
  logoUrl  String?

  jobs         Job[]
  internships  Internship[]
}

model Job {
  id             Int    @id @default(autoincrement())
  companyId      Int
  title          String
  description    String
  experienceReq  String // e.g. "0-2 years", "2-5 years"
  location       String
  workMode       String // REMOTE | HYBRID | ON_SITE
  salaryMin      Float?
  salaryMax      Float?
  salaryPeriod   String? // ANNUAL | MONTHLY | DAILY
  currency       String  @default("INR")
  postedAt       DateTime @default(now())
  isActive       Boolean  @default(true)
  skillsRequired String   @default("[]") // JSON array of skill names

  company      Company       @relation(fields: [companyId], references: [id])
  applications Application[]
  jobSkills    JobSkill[]
}

model JobSkill {
  id      Int @id @default(autoincrement())
  jobId   Int
  skillId Int

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([jobId, skillId])
}

model Internship {
  id             Int    @id @default(autoincrement())
  companyId      Int
  title          String
  description    String
  eligibility    String  // e.g. "2nd/3rd year students, Freshers"
  duration       String  // e.g. "3 months", "6 months"
  location       String
  workMode       String  // REMOTE | HYBRID | ON_SITE
  stipendMin     Float?
  stipendMax     Float?
  stipendPeriod  String? // MONTHLY | WEEKLY | DAILY
  currency       String  @default("INR")
  skillsRequired String  @default("[]") // JSON array of skill names
  postedAt       DateTime @default(now())
  isActive       Boolean  @default(true)

  company      Company       @relation(fields: [companyId], references: [id])
  applications Application[]
}

model Application {
  id           Int      @id @default(autoincrement())
  userId       Int
  jobId        Int?
  internshipId Int?
  status       String   @default("APPLIED") // APPLIED | SHORTLISTED | REJECTED | OFFERED
  appliedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job?        @relation(fields: [jobId], references: [id])
  internship Internship? @relation(fields: [internshipId], references: [id])
}

// ─────────────────────────────────────────────
// PROGRESS RECORDS
// ─────────────────────────────────────────────

model ProgressRecord {
  id              Int      @id @default(autoincrement())
  userId          Int
  weekNumber      Int
  studyHours      Float    @default(0)
  tasksCompleted  Int      @default(0)
  tasksTotal      Int      @default(0)
  aptitudeAvg     Float?
  adherencePct    Float    @default(0)
  xpEarned        Int      @default(0)
  recordedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// CHATBOT
// ─────────────────────────────────────────────

model ChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  role      String   // USER | ASSISTANT
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // STREAK | JOB | INTERNSHIP | GOAL | BADGE | XP
  title     String
  body      String
  link      String?  // e.g. "/roadmap", "/jobs"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
