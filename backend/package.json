{
  "name": "placemate-ai-backend",
  "version": "1.0.0",
  "description": "PlaceMate AI — Express.js backend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "build": "node node_modules/prisma/build/index.js generate --schema=../prisma/schema.prisma",
    "postinstall": "node node_modules/prisma/build/index.js generate --schema=../prisma/schema.prisma",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev --schema=../prisma/schema.prisma",
    "db:generate": "node node_modules/prisma/build/index.js generate --schema=../prisma/schema.prisma",
    "db:seed": "node ../prisma/seed.js",
    "db:studio": "node node_modules/prisma/build/index.js studio --schema=../prisma/schema.prisma",
    "db:push": "node node_modules/prisma/build/index.js db push --schema=../prisma/schema.prisma",
    "db:reset": "node node_modules/prisma/build/index.js db push --schema=../prisma/schema.prisma --force-reset && npm run db:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.12.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
